---
const venue = 'Centro de eventos San Joaquín sede la 70';
const address = 'Calle 44 A # 70-32';
const mapQuery = encodeURIComponent(`${venue}, ${address}`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Invitación para los XV años de Valeria Sepúlveda Garcés." />
    <title>Los XV de Valeria Sepúlveda Garcés</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="title">
        <div class="topline"><span>Mis XV</span><i aria-hidden="true"></i><span>Una noche especial</span></div>
        <div class="monogram" aria-hidden="true"><span>XV</span><b>V</b></div>
        <div class="hero-copy"><p class="eyebrow">Con mucha alegría</p><h1 id="title">Valeria<br /><em>Sepúlveda Garcés</em></h1><p class="intro">Te invito a celebrar conmigo<br />el comienzo de una nueva etapa.</p></div>
        <a class="scroll" href="#invitation">Descubre la invitación <span aria-hidden="true">↓</span></a>
      </section>

      <section class="invitation" id="invitation" aria-labelledby="invitation-title">
        <p class="label">La invitación</p><div class="rule"></div>
        <p class="small-title">Será una noche para</p><h2 id="invitation-title">brillar<br /><em>juntos.</em></h2>
        <p class="copy">Quiero compartir contigo la ilusión de mis quince años y guardar este momento para siempre.</p>
        <p class="signature">Con cariño,<br /><strong>Valeria</strong></p>
      </section>

      <section class="pending" aria-labelledby="date-title">
        <p class="label">01 / Guarda este momento</p><h2 id="date-title">La fecha y la hora<br /><em>están por confirmar.</em></h2>
        <span class="pending-mark" data-novi-placeholder="event.date">Fecha por confirmar</span><span class="pending-mark" data-novi-placeholder="event.time">Hora por confirmar</span>
      </section>

      <section class="venue" aria-labelledby="venue-title">
        <div class="venue-art" aria-hidden="true"><span class="circle"></span><span class="line line-a"></span><span class="line line-b"></span><span class="star">✦</span></div>
        <div class="venue-copy"><p class="label">02 / El encuentro</p><h2 id="venue-title">Centro de eventos<br /><em>San Joaquín</em></h2><p class="venue-name">Sede la 70</p><address>{address}</address><a class="map" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noreferrer">Ver ubicación <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="closing" aria-labelledby="closing-title"><p class="label">03 / Será un honor</p><h2 id="closing-title">Tu presencia<br /><em>lo hará inolvidable.</em></h2><p class="copy">La confirmación y los detalles de la celebración estarán disponibles <strong>por confirmar</strong>.</p><span class="pending-mark" data-novi-placeholder="event.rsvp">Confirmación por confirmar</span></section>
    </main>
    <footer>Valeria Sepúlveda Garcés <span>✦</span> Mis XV</footer>
  </body>
</html>

<style>
  :root{--black:#0b0b0b;--white:#f8f7f2;--paper:#ecebe6;--gold:#c5a25a;--line:rgba(11,11,11,.22)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--black);font-family:Manrope,Arial,sans-serif}main{overflow:hidden}h1,h2,p{margin:0}h1,h2{font-family:'DM Serif Display',Georgia,serif;font-weight:400;line-height:.86;letter-spacing:-.055em}h1{font-size:clamp(4rem,11vw,9.5rem)}h2{font-size:clamp(3.6rem,9vw,8rem)}em{font-style:italic}.hero{min-height:100svh;padding:clamp(1.3rem,4vw,3rem);background:var(--black);color:var(--white);display:flex;flex-direction:column;justify-content:space-between;position:relative;isolation:isolate}.hero:after{content:'';position:absolute;inset:5%;border:1px solid rgba(197,162,90,.45);z-index:-1;pointer-events:none}.topline,.label,.scroll,footer{font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.14em;font-size:.62rem}.topline{display:flex;gap:.8rem;align-items:center;color:var(--gold)}.topline i{width:4px;height:4px;background:var(--gold);border-radius:50%}.monogram{position:absolute;right:10%;top:18%;color:rgba(197,162,90,.18);font-family:'DM Serif Display';font-size:clamp(11rem,30vw,27rem);line-height:.65}.monogram b{position:absolute;right:3%;top:37%;font-size:.18em;color:var(--gold);font-weight:400}.hero-copy{margin:auto 0 7vh;padding-left:4vw}.eyebrow{font-family:'DM Mono';text-transform:uppercase;letter-spacing:.16em;font-size:.68rem;color:var(--gold);margin-bottom:1.3rem}.intro{font-size:.88rem;line-height:1.8;margin-top:2rem}.scroll{border-top:1px solid rgba(248,247,242,.4);padding-top:1rem;display:flex;justify-content:space-between;color:inherit;text-decoration:none}.scroll span{color:var(--gold);font-size:1.3rem}.label{color:var(--gold);margin-bottom:2rem}.invitation{padding:clamp(5rem,12vw,11rem) clamp(1.3rem,14vw,15rem);background:var(--paper)}.rule{width:100%;height:1px;background:var(--line);margin-bottom:2.4rem}.small-title{font-family:'DM Mono';text-transform:uppercase;letter-spacing:.1em;font-size:.7rem;margin-bottom:1.4rem}.invitation h2{font-size:clamp(4rem,12vw,10rem)}.copy{max-width:27rem;line-height:1.8;font-size:.9rem}.invitation .copy{margin:2.6rem 0 0 auto}.signature{margin-top:3rem;font-family:'DM Serif Display';font-size:1.5rem}.signature strong{color:#8d6a29;font-weight:400}.pending{background:var(--white);padding:clamp(5rem,12vw,11rem) clamp(1.3rem,8vw,9rem);min-height:34rem}.pending h2{max-width:58rem}.pending-mark{display:inline-block;margin-top:3rem;border:1px solid var(--gold);padding:.7rem 1rem;font-family:'DM Mono';font-size:.65rem;letter-spacing:.1em;text-transform:uppercase}.venue{display:grid;grid-template-columns:1fr 1fr;background:var(--black);color:var(--white)}.venue-art{min-height:38rem;position:relative;overflow:hidden;border-right:1px solid rgba(248,247,242,.2);background:radial-gradient(circle at 50% 38%,#423820,#151515 46%,#080808)}.circle{position:absolute;width:43%;aspect-ratio:1;border:1px solid var(--gold);border-radius:50%;top:22%;left:29%;box-shadow:0 0 0 2rem rgba(197,162,90,.04),0 0 0 5rem rgba(197,162,90,.025)}.line{position:absolute;width:1px;background:linear-gradient(transparent,var(--gold));height:70%;bottom:-5%}.line-a{left:28%;transform:rotate(25deg)}.line-b{left:72%;transform:rotate(-20deg)}.star{position:absolute;color:var(--gold);font-size:2rem;top:32%;left:47%}.venue-copy{padding:clamp(3rem,8vw,8rem);align-self:center}.venue h2{font-size:clamp(3.2rem,7vw,6.5rem)}.venue-name{color:var(--gold);font-family:'DM Mono';text-transform:uppercase;letter-spacing:.12em;font-size:.72rem;margin-top:1.5rem}address{font-style:normal;line-height:1.8;margin:2.2rem 0}.map{color:inherit;text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:.7rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.map span{color:var(--gold);margin-left:1.5rem;font-size:1.1rem}.closing{background:var(--paper);padding:clamp(5rem,12vw,11rem) clamp(1.3rem,14vw,15rem);text-align:center}.closing .copy{margin:2rem auto 0}.closing h2 em{color:#8d6a29}footer{background:#050505;color:var(--white);padding:1.2rem;text-align:center;font-size:.55rem}footer span{color:var(--gold);margin:0 .65rem}a:focus-visible{outline:2px solid var(--gold);outline-offset:5px}@media(max-width:680px){.hero{min-height:45rem}.hero:after{inset:3%}.hero-copy{padding-left:0}.monogram{right:-3%;top:28%;font-size:13rem}.venue{grid-template-columns:1fr}.venue-art{min-height:24rem;border-right:0;border-bottom:1px solid rgba(248,247,242,.2)}.venue-copy{min-height:31rem}.invitation .copy{margin-left:0}.closing{text-align:left}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
